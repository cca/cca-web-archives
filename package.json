{
  "name": "cca-web-archive-viewer",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "test": "npm run check && npm run lint",
    "sscompile": "tsc --ignoreConfig scripts/squarespace.ts --outDir scripts",
    "flcompile": "tsc --ignoreConfig scripts/fix-links.ts --outDir scripts"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "cheerio": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "astro": "^7.4.12",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
